{
  "name": "x402-redteam",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.6+sha512.7e1ae66a83a9143c118cc1944f37cc4f2b8acddeda4b001cfa78908f6e46e45e15292739ca6c9d026426cc757e9318cc98c5551d6a16c165097b0028ba87b4e6",
  "engines": {
    "node": ">=22.14"
  },
  "scripts": {
    "build": "pnpm -r build",
    "test": "vitest run --exclude \"**/*.e2e.test.ts\" --exclude \"**/node_modules/**\"",
    "test:coverage": "vitest run --coverage --exclude \"**/*.e2e.test.ts\" --exclude \"**/node_modules/**\"",
    "test:e2e": "vitest run --project cli e2e",
    "test:all": "vitest run",
    "lint": "biome check .",
    "format": "biome format --write .",
    "typecheck": "pnpm -r typecheck",
    "leaderboard": "tsx packages/leaderboard/src/main.ts",
    "x402-redteam": "node packages/cli/bin/x402-redteam.mjs",
    "prepare-hooks": "git config core.hooksPath .githooks"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@types/node": "24.19.1",
    "@vitest/coverage-v8": "5.0.2",
    "typescript": "6.0.3",
    "vitest": "5.0.2",
    "tsx": "4.23.15"
  }
}
