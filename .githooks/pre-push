#!/bin/sh
# Held-out leak guard (ADR-027; no-op without a local denylist) and the fuzz-privacy guard
# (ADR-028 #7; always on) on commits about to be pushed. Both read the refs from stdin.
refs=$(cat)
printf '%s\n' "$refs" | node scripts/heldout-guard.mjs --pre-push && printf '%s\n' "$refs" | node scripts/fuzz-guard.mjs --pre-push
